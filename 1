var a: array[1..20] of integer;
n, buf, pol: integer;
begin
 write('Количество n =');
 readln(n);
 if n mod 2 <> 0 then
  writeln('n должно быть чётным числом')
 else
 begin
   writeln('Элементы массива');
   for var i := 1 to n do
    read(a[i]);
   pol := n div 2;
   for var i := 1 to pol do
   begin
    buf := a[i];
    a[i] := a[pol + i];
    a[pol + i] := buf;
   end;
   writeln('Преобразованный массив');
   for var i := 1 to n do
    write(a[i], ' ');
 end;
end.
